{
  "name": "speaking-to-ais",
  "version": "0.1.0",
  "description": "Speaking to AIs: a local recorded conversation with Claude and Astra, using your own subscriptions and ElevenLabs voices.",
  "license": "MIT",
  "type": "module",
  "keywords": ["claude", "claude-code", "codex", "astra", "voice", "conversation", "elevenlabs", "recording"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "login": "node scripts/login.mjs",
    "test": "node --test tests/*.test.mjs",
    "review": "node --env-file-if-exists=.env scripts/review.mjs",
    "interview": "node --env-file-if-exists=.env scripts/cli.mjs"
  }
}
