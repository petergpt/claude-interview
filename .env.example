# Optional backend settings. Copy to .env (never commit it). ./interview loads it automatically.
# On macOS you can skip the keys here and use ./interview key set (stored in Keychain) instead.

# ElevenLabs key with Text to Speech, Speech to Text and Voices (read) permissions.
# ELEVENLABS_API_KEY=

# Claude runs through your installed Claude Code CLI and its own subscription login (./interview login).
# To bill an Anthropic API key instead, set both:
# INTERVIEW_CLAUDE_AUTH=api
# ANTHROPIC_API_KEY=

# CLAUDE_BIN=claude                # path to the Claude Code CLI if it is not on PATH
# FFMPEG_BIN=ffmpeg                # path to ffmpeg (native talk and streaming)
# INTERVIEW_PORT=4747
# INTERVIEW_USER_NAME=             # default display name for CLI calls (the browser has its own field)
# INTERVIEW_SKETCH_MODEL=claude-sonnet-5    # quick first sketch of each picture
# INTERVIEW_SCENE_MODEL=claude-opus-5-5     # finishes each picture

# Optional live streaming to X: the server address can also be typed in Settings.
# X_STREAM_URL=
# X_STREAM_KEY=
